{
  "name": "maiatesta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir .ssg-server && node scripts/prerender.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:cls": "node scripts/check-cls.mjs",
    "check:scroll-load": "node scripts/check-scroll-load.mjs",
    "check:scroll-performance": "node scripts/check-scroll-performance.mjs",
    "check:visual": "playwright test tests/homepage-regression.spec.ts tests/homepage-background-video.spec.ts --workers=1",
    "check:seo": "node scripts/check-seo-pages.mjs",
    "create:article": "node scripts/create-seo-article.mjs",
    "perf:test": "npm run build && npm run check:bundle && npm run check:cls && npm run check:scroll-load && npm run check:scroll-performance",
    "seo:test": "npm run build && npm run check:seo",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
