// Esquema de datos para el backend de WhatsApp Business App Coexistence.
//
// Principio de diseño rector (sección 7 del pedido): un usuario de Facebook
// NO es un tenant, NO es una WABA, NO es un número. La cadena de relación
// explícita, ya documentada en docs/meta-whatsapp-embedded-signup.md antes
// de que este backend existiera, se modela aquí exactamente:
//
//   Tenant -> MetaAuthorization -> WhatsappBusinessAccount -> PhoneNumber
//
// Cada tabla que pertenece a un tenant tiene tenantId como columna directa
// (no solo alcanzable por join), precisamente para que las pruebas de
// aislamiento multiempresa (tests/integration/tenant-isolation.test.ts)
// puedan verificar el filtro al nivel de la propia query, no confiar en
// que la aplicación "se acuerde" de filtrar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant y usuarios administrativos
// ---------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  adminUsers                   AdminUser[]
  onboardingSessions           OnboardingSession[]
  metaAuthorizations           MetaAuthorization[]
  auditLogs                    AuditLog[]
  conversationAutomationStates ConversationAutomationState[]
  messageEvents                MessageEvent[]
  webhookSubscriptions         WabaWebhookSubscription[]
  wabaRoutes                   WabaRoute[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model AdminUser {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  role      AdminRole @default(OWNER)
  createdAt DateTime  @default(now())

  // Un mismo email de administrador no puede repetirse dentro del mismo
  // tenant, pero el mismo email SÍ puede administrar tenants distintos
  // (agencia gestionando varios clientes) — por eso el unique es compuesto,
  // no solo sobre email.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("admin_users")
}

enum AdminRole {
  OWNER
  OPERATOR
}

// ---------------------------------------------------------------------------
// Onboarding — sesiones efímeras, nunca confían en un tenantId enviado
// libremente desde el navegador (sección 6 del pedido)
// ---------------------------------------------------------------------------

model OnboardingSession {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adminUserId     String
  // Nonce opaco de un solo uso, entregado al frontend y devuelto en
  // /onboarding/session y /onboarding/complete — el tenantId real se resuelve
  // en el servidor a partir de ESTE nonce, nunca de un campo del body.
  nonce           String          @unique
  state           OnboardingState @default(INITIATED)
  metaSessionInfo Json? // business_id/waba_id/phone_number_id recibidos vía postMessage (sección Recepción de Meta)
  failureReason   String?
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  metaAuthorization MetaAuthorization?

  @@index([tenantId])
  @@index([expiresAt])
  @@map("onboarding_sessions")
}

// Estados de la sección 13 del pedido, adaptados a nombres de columna.
enum OnboardingState {
  INITIATED
  AWAITING_AUTHORIZATION
  AUTHORIZED_BY_META
  CREDENTIALS_VERIFIED
  INTERNAL_CONFIG_PENDING
  OPERATIONAL
  RECOVERABLE_ERROR
  CANCELLED
  EXPIRED
  DISCONNECTED
}

// ---------------------------------------------------------------------------
// Autorización de Meta — UNA fila por (tenant, app-scoped Meta user).
// Esta es la tabla que el P0 ya documentado en el repo Vercel dice que debe
// existir antes de conectar los stubs de deauthorize/data-deletion a algo
// real. metaUserId es el identificador que Meta manda en signed_request —
// nunca se asume que es el mismo valor entre apps ni que identifica a un
// tenant por sí solo (de ahí que la relación sea explícita, no implícita).
// ---------------------------------------------------------------------------

model MetaAuthorization {
  id                  String              @id @default(uuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  onboardingSessionId String              @unique
  onboardingSession   OnboardingSession   @relation(fields: [onboardingSessionId], references: [id])
  metaUserId          String // app-scoped user id de Meta (payload.user_id de signed_request)
  status              AuthorizationStatus @default(ACTIVE)
  revokedAt           DateTime?
  revokedReason       String? // 'deauthorize_callback' | 'data_deletion_callback' | 'manual', nunca inferido
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  whatsappBusinessAccounts WhatsappBusinessAccount[]
  credentials              Credential[]

  // Un mismo usuario de Meta autorizando el mismo tenant dos veces reutiliza
  // la fila (no crea duplicados silenciosos) — pero el mismo metaUserId SÍ
  // puede aparecer en tenants distintos (una persona administra dos negocios).
  @@unique([tenantId, metaUserId])
  @@index([metaUserId])
  @@map("meta_authorizations")
}

enum AuthorizationStatus {
  ACTIVE
  REVOKED
}

// ---------------------------------------------------------------------------
// WABA y números — la relación real que la sección 7 del pedido exige no
// asumir 1:1: una WABA puede tener más de un número, un tenant puede tener
// más de una WABA (multi-marca).
// ---------------------------------------------------------------------------

model WhatsappBusinessAccount {
  id                  String            @id @default(uuid())
  metaAuthorizationId String
  metaAuthorization   MetaAuthorization @relation(fields: [metaAuthorizationId], references: [id], onDelete: Cascade)
  wabaId              String            @unique // ID real de Meta — global, nunca reutilizado entre tenants
  businessName        String?
  createdAt           DateTime          @default(now())

  phoneNumbers PhoneNumber[]

  @@map("whatsapp_business_accounts")
}

model PhoneNumber {
  id                        String                  @id @default(uuid())
  whatsappBusinessAccountId String
  whatsappBusinessAccount   WhatsappBusinessAccount @relation(fields: [whatsappBusinessAccountId], references: [id], onDelete: Cascade)
  phoneNumberId             String                  @unique // Phone Number ID de Meta — global; el UNIQUE es la defensa técnica contra "número ya asociado a otro cliente" (sección 6 del pedido)
  displayPhoneNumber        String?
  // Campos del modelo de cuentas v4 — ver docs/META_V4_COMPATIBILITY.md §4.
  // isOnBizApp confirma, contra la respuesta real de Graph API, que la
  // conexión sigue siendo Coexistence (número dual) y no una migración
  // completa — no se asume, se verifica y se persiste.
  isOnBizApp                Boolean?
  platformType              String?
  connectionState           ConnectionState         @default(PENDING_INTERNAL_SETUP)
  connectedAt               DateTime?
  disconnectedAt            DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  integrationConfig            IntegrationConfig?
  messageEvents                MessageEvent[]
  conversationAutomationStates ConversationAutomationState[]

  @@map("phone_numbers")
}

enum ConnectionState {
  PENDING_INTERNAL_SETUP
  OPERATIONAL
  ERROR
  DISCONNECTED
}

// ---------------------------------------------------------------------------
// Credenciales cifradas — NUNCA texto plano. Ver src/crypto/tokenCipher.ts
// (AES-256-GCM, autenticado). El App Secret de Meta NUNCA se reutiliza como
// clave de cifrado (instrucción explícita del pedido) — esta tabla se cifra
// con META_TOKEN_ENCRYPTION_KEY, una variable completamente independiente.
// ---------------------------------------------------------------------------

model Credential {
  id                  String            @id @default(uuid())
  metaAuthorizationId String
  metaAuthorization   MetaAuthorization @relation(fields: [metaAuthorizationId], references: [id], onDelete: Cascade)
  kind                CredentialKind
  // Ciphertext + IV + auth tag, todo en un solo string serializado (ver
  // tokenCipher.ts) — nunca hay una columna "value" en texto plano aquí.
  encryptedValue      String
  createdAt           DateTime          @default(now())
  rotatedAt           DateTime?

  @@index([metaAuthorizationId])
  @@map("credentials")
}

enum CredentialKind {
  SYSTEM_USER_ACCESS_TOKEN
  WHATSAPP_ACCESS_TOKEN
}

// ---------------------------------------------------------------------------
// Configuración de integración con la infraestructura de mensajería —
// deliberadamente laxa (JSON) en esta etapa porque los adaptadores reales de
// Evolution/Chatwoot/Typebot/n8n son la Etapa 4, todavía no aprobada.
// ---------------------------------------------------------------------------

model IntegrationConfig {
  id                  String      @id @default(uuid())
  phoneNumberId       String      @unique
  phoneNumber         PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  evolutionInstanceId String?
  chatwootAccountId   String?
  chatwootInboxId     String?
  typebotFlowId       String?
  n8nWorkflowId       String?
  provisionedAt       DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("integration_configs")
}

// ---------------------------------------------------------------------------
// Eventos de mensaje — clasificación explícita (sección 4/8 del pedido de la
// Etapa 3) y deduplicación persistente de eventos de webhook. metaEventId es
// la clave de deduplicación real: el mismo evento reenviado por Meta
// (reintento del payload completo, o un chunk de historial repetido) debe
// producir la MISMA fila, no una nueva — ver src/webhook/dedupe.ts para cómo
// se calcula por tipo de evento.
//
// processingState separa la RECEPCIÓN (este registro, dentro de la misma
// transacción que confirma el webhook a Meta) del PROCESAMIENTO asíncrono
// (el worker de src/webhook/worker.ts, que corre después y por separado) —
// sección 6 del pedido: "la recepción del webhook debe quedar separada de
// las integraciones posteriores".
// ---------------------------------------------------------------------------

model MessageEvent {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wabaId            String
  phoneNumberId     String?
  phoneNumber       PhoneNumber?     @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  metaEventId       String // clave de deduplicación — ver src/webhook/dedupe.ts
  idempotencyKey    String           @unique
  direction         MessageDirection
  origin            MessageOrigin
  waMessageId       String?
  contactWaId       String?
  // Tipo de mensaje reportado por Meta (text/image/interactive/...) o el
  // "status" de una actualización de entrega — nunca el contenido en sí.
  messageType       String?
  statusValue       String? // solo para origin=STATUS_UPDATE: sent/delivered/read/failed
  hasMetaError      Boolean          @default(false) // el sub-evento traía su propio `errors[]` (p. ej. tipo no soportado)
  receivedAt        DateTime         @default(now())
  rawPayloadHash    String // hash del payload crudo, nunca el payload completo con contenido de conversación
  encryptedPayload  String // sub-evento cifrado AES-256-GCM; necesario para recuperación/reproceso
  normalizedPayload Json?
  eventCategory     String
  contractVersion   Int              @default(1)
  eventTimestamp    DateTime?

  // Resultado de la clasificación de la sección 8 (prevención de bucles) —
  // calculado en la recepción, RE-confirmado por el worker antes de
  // cualquier despacho futuro a Typebot/n8n (Etapa 4). Solo CUSTOMER, sin
  // error, y con la conversación sin pausar, puede quedar en true.
  eligibleForAutomation Boolean @default(false)

  processingState     ProcessingState @default(PENDING)
  processingAttempts  Int             @default(0)
  lastProcessingError String? // clase/mensaje del error, nunca contenido de conversación
  lastErrorCode       String?
  nextAttemptAt       DateTime        @default(now())
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  duplicateCount      Int             @default(0)
  lastReceivedAt      DateTime        @default(now())
  retentionExpiresAt  DateTime
  processedAt         DateTime?

  @@unique([phoneNumberId, metaEventId])
  @@index([tenantId, processingState, nextAttemptAt])
  @@index([phoneNumberId, receivedAt])
  @@index([processingState, nextAttemptAt])
  @@map("message_events")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  ADMINISTRATIVE // sincronización de contactos/historial, eventos de cuenta — no es un mensaje en ningún sentido
}

enum MessageOrigin {
  CUSTOMER // mensaje real de un cliente externo (campo "messages")
  BUSINESS_APP_ECHO // enviado manualmente desde WhatsApp Business por un empleado (campo "smb_message_echoes")
  API_SENT // enviado por nuestra infraestructura vía la API (Etapa 4 — no se recibe por webhook, se sabe en el momento del envío)
  STATUS_UPDATE // confirmaciones de entrega/lectura de un mensaje que SÍ enviamos (campo "messages" -> statuses[])
  CONTACT_SYNC // sincronización de contactos de Coexistence (campo "smb_app_state_sync")
  HISTORY_SYNC // mensajes históricos sincronizados al conectar (campo "history")
  ACCOUNT_EVENT // cambios de estado de la cuenta/número (campo "account_update")
  UNCLASSIFIED // cualquier campo que Meta agregue y este backend todavía no reconozca — nunca se descarta silenciosamente, nunca dispara automatización
}

enum ProcessingState {
  PENDING // recibido, validado y persistido duraderamente
  PROCESSING // reclamado por un worker con lease temporal
  RETRY_PENDING // fallo transitorio; espera nextAttemptAt
  PROCESSED // el worker terminó su verificación/clasificación final con éxito
  QUARANTINED // auténtico pero no procesable automáticamente
  FAILED // compatibilidad con el borrador anterior; no se usa para nuevas transiciones
  MANUAL_INTERVENTION // se agotaron los reintentos — requiere revisión humana, no se reintenta más automáticamente
}

model WebhookQuarantineEvent {
  id                 String   @id @default(uuid())
  wabaId             String?
  rawPayloadHash     String
  encryptedPayload   String
  reasonCode         String
  receivedAt         DateTime @default(now())
  lastReceivedAt     DateTime @default(now())
  duplicateCount     Int      @default(0)
  retentionExpiresAt DateTime

  @@unique([wabaId, rawPayloadHash, reasonCode])
  @@index([reasonCode, receivedAt])
  @@map("webhook_quarantine_events")
}

model WabaWebhookSubscription {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wabaId        String    @unique
  status        String
  checkedAt     DateTime?
  subscribedAt  DateTime?
  lastErrorCode String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@map("waba_webhook_subscriptions")
}

model WebhookWorkerHeartbeat {
  workerId       String   @id
  status         String
  startedAt      DateTime
  lastSeenAt     DateTime
  processedCount Int      @default(0)
  lastErrorCode  String?

  @@index([lastSeenAt])
  @@map("webhook_worker_heartbeats")
}

// ---------------------------------------------------------------------------
// Estado de automatización por conversación (sección 8 del pedido de la
// Etapa 3: "desactivación de respuestas automáticas cuando un agente humano
// está atendiendo la conversación"). Todavía no hay integración con Chatwoot
// (Etapa 4) que escriba aquí automáticamente al asignar un agente — esta
// tabla es el punto de extensión que la Etapa 4 usará; por ahora se prueba
// activando/desactivando la pausa directamente y confirmando que
// eligibleForAutomation responde a ese estado.
// ---------------------------------------------------------------------------

model ConversationAutomationState {
  id               String      @id @default(uuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumberId    String // PhoneNumber.id interno (el número del negocio)
  phoneNumber      PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  contactWaId      String // wa_id del cliente — junto con phoneNumberId identifica la conversación
  automationPaused Boolean     @default(false)
  pausedReason     String? // 'human_agent_assigned' | 'manual' — nunca contenido de conversación
  pausedBy         String? // id de administrador o 'system' — nunca un token
  updatedAt        DateTime    @updatedAt
  createdAt        DateTime    @default(now())

  @@unique([phoneNumberId, contactWaId])
  @@map("conversation_automation_state")
}

// ---------------------------------------------------------------------------
// Tabla de enrutamiento — deliberadamente SIN Row-Level Security. Resuelve
// "cómo identificar el tenant ANTES de poder fijar el contexto de RLS"
// (sección 3 del pedido de la Etapa 3): las demás tablas (phone_numbers,
// etc.) tienen RLS forzado, así que son ilegibles sin ya conocer el tenant.
//
// Clave elegida — el WABA id (`entry[].id`), NO el phone_number_id: el WABA
// id está presente en TODO payload de webhook de WhatsApp sin excepción
// (confirmado leyendo ejemplos reales de messages/statuses/smb_message_echoes
// /smb_app_state_sync/history/account_update — todos anidan bajo el mismo
// `entry[].id`), mientras que la ubicación del identificador de número
// cambia según el campo: `value.metadata.phone_number_id` para la mayoría,
// pero `value.phone_number` (sin "_id", sin envoltorio metadata) para
// account_update. Enrutar siempre por WABA evita tener que enseñarle a esta
// tabla, que no tiene RLS y por tanto debe permanecer lo más pequeña y
// auditable posible, las particularidades de cada tipo de evento — eso se
// resuelve DESPUÉS, ya con el tenant (y por tanto RLS) activo, vía
// `TenantScope.phoneNumbers().findByExternalId/findByDisplayNumber`.
//
// Por qué es seguro que esta tabla NO tenga RLS: solo contiene el WABA id
// (ya público en cada webhook que Meta nos envía) y el tenantId interno —
// cero contenido de conversación, cero credenciales, cero PII de clientes.
// No expone ninguna operación de lectura de contenido — solo mapea
// WABA id -> tenantId, el primer paso obligatorio antes de poder hacer
// cualquier otra cosa con TenantScope.
//
// Se escribe exclusivamente dentro de la misma transacción que
// TenantScope.metaAuthorizations().completeAuthorization() (Etapa 2) — nunca
// puede quedar desincronizada porque se escribe atómicamente junto con la
// WABA real.
// ---------------------------------------------------------------------------

model WabaRoute {
  wabaId    String   @id // WhatsApp Business Account ID de Meta — entry[].id de cada webhook
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("waba_routes")
}

// ---------------------------------------------------------------------------
// Auditoría — append-only, tenant-scoped, nunca contiene tokens/códigos.
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor     String // 'system' | 'meta_callback' | admin user id
  action    String // ej. 'onboarding.started', 'authorization.revoked'
  metadata  Json? // nunca tokens/códigos/PII de conversación — solo IDs y estados
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
