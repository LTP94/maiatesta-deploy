# Variables para docker-compose.hostinger.yml. Copiar a .env.hostinger en el
# VPS (NUNCA en git) y rellenar con valores reales generados en el propio
# servidor — ninguno de estos debe generarse ni transmitirse en esta
# conversación ni en ningún repositorio.

POSTGRES_OWNER_USER=maiatesta_whatsapp_owner
# openssl rand -hex 24
POSTGRES_OWNER_PASSWORD=

# Contraseña del rol app_runtime (RLS-restringido) — se fija DESPUÉS del
# primer `docker compose run backend npx prisma migrate deploy`, ejecutando
# scripts/bootstrap-db-roles.sh (o el equivalente vía `docker exec`) con
# OWNER_DATABASE_URL apuntando a este Postgres. openssl rand -hex 24
APP_RUNTIME_DB_PASSWORD=

META_APP_ID=
# El App Secret real de Meta — nunca compartido con el agente de desarrollo.
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
# openssl rand -hex 32
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# openssl rand -hex 32 — independiente de META_APP_SECRET, ver
# ARCHITECTURE_DECISION.md sección de gestión de claves antes de generar.
META_TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32
META_ONBOARDING_SESSION_SECRET=
