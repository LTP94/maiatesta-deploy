# Copiar a .env.hostinger en el VPS, propietario root y modo 600. Nunca
# versionar el archivo real. Los valores vacíos deben generarse en el VPS.

BACKEND_IMAGE_TAG=pilot-YYYYMMDD-SHORTSHA
BACKEND_INGRESS_NETWORK=maiatesta_backend_ingress
BACKUP_DIR=/opt/maiatesta-whatsapp/backups
POSTGRES_DB=maiatesta_whatsapp
POSTGRES_OWNER_USER=maiatesta_whatsapp_owner

# Usar valores hexadecimales para evitar problemas de escape en URLs.
# openssl rand -hex 24
POSTGRES_OWNER_PASSWORD=
APP_RUNTIME_DB_PASSWORD=
REDIS_PASSWORD=

# Orígenes exactos, separados por coma; nunca usar *.
ALLOWED_ORIGINS=https://maiatesta.com,https://www.maiatesta.com

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Cada clave debe ser independiente. Las tres claves *_KEY son 32 bytes
# codificados como exactamente 64 caracteres hexadecimales.
META_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_PAYLOAD_ENCRYPTION_KEY=
META_ONBOARDING_SESSION_SECRET=
META_INVITATION_TOKEN_SECRET=
ADMIN_API_KEY=
HEALTHCHECK_TOKEN=

# Limpieza automática: cada 15 minutos, lotes de hasta 500 filas por tabla.
WEBHOOK_RETENTION_CLEANUP_INTERVAL_MS=900000
WEBHOOK_RETENTION_BATCH_SIZE=500
